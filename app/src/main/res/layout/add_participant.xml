<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/stat_margin">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top">
        <ImageView
            android:src="@drawable/ic_launcher_foreground"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:scaleType="center"
            android:background="@color/gold"
            android:contentDescription="@string/app_name" />
        <EditText
            android:id="@+id/enter_name_field"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="@dimen/stat_margin"
            android:padding="@dimen/stat_margin"
            android:hint="@string/choose_the_name_caption"
            android:inputType="text">
        </EditText>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/enter_HP_field"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:padding="@dimen/stat_margin"
                android:autofillHints="Enter HP"
                android:hint="Enter HP"
                android:inputType="number"/>
            <EditText
                android:id="@+id/enter_SH_field"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:padding="@dimen/stat_margin"
                android:autofillHints="Enter SH"
                android:hint="Enter Shield"
                android:inputType="number"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/enter_AR_field"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_weight="1.3"
                android:padding="@dimen/stat_margin"
                android:autofillHints="Enter AR"
                android:hint="Enter AR"
                android:inputType="number"/>
            <EditText
                android:id="@+id/enter_IN_field"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:padding="@dimen/stat_margin"
                android:autofillHints="Enter Initiative"
                android:hint="Enter Initiative"
                android:inputType="number"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>