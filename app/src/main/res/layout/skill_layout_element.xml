<?xml version="1.0" encoding="utf-8"?>

    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/skill_modifier"
            android:layout_width="25dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="7dp"
            android:fontFamily="@font/lucida_calligraphy_italic"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textSize="16dp"
            android:text="+2"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/skill_checkbox"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="5dp"
            android:layout_marginVertical="5dp"
            app:iconSize="10dp"
            app:iconPadding="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@null"
            android:background="@drawable/base_skill_icon"
            android:fontFamily="@font/lucida_calligraphy_italic"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textSize="@dimen/stat_desc_text_size"
            android:gravity="center"
            android:tag=""/>
        <TextView
            android:id="@+id/skill_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginVertical="7dp"
            android:fontFamily="@font/lucida_calligraphy_italic"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textSize="14dp"
            android:text="Skill_name (S)"/>
    </LinearLayout>
