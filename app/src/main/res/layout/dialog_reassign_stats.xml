<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/stat_margin">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top">
        <ImageView
            android:src="@mipmap/main_icon_symbol_foreground"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:scaleType="center"
            android:background="@color/gold"
            android:contentDescription="@string/app_name" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/frame_margin"
            android:textAlignment="center"
            android:justificationMode="inter_word"
            android:text="Player can assign value in range from 0 to 15 to each attribute. But higher have higher costs. Player can assign attribute values such as the sum of its costs is not greater than 27. All values and their costs are displayed below."/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:layout_margin="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="textEnd"
                    android:text="Value\n8\n9\n10\n11"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:text=" - \n - \n - \n - \n - "/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="textStart"
                    android:text="Cost\n0\n1\n2\n3"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:layout_margin="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="textEnd"
                    android:text="Value\n12\n13\n14\n15"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:text=" - \n - \n - \n - \n - "/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="textStart"
                    android:text="Cost\n4\n5\n7\n9"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/character_class_margin"
                android:gravity="end"
                android:orientation="vertical"
                android:layout_weight="1">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/stat_margin"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lucida_calligraphy_italic"
                        android:textStyle="bold"
                        android:textSize="24dp"
                        android:text="S:"/>
                    <TextView
                        android:id="@+id/S_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:fontFamily="@font/lucida_calligraphy_italic"
                        android:textStyle="bold"
                        android:textSize="24dp"
                        android:text="10"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/S_plus"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_margin="@dimen/stat_margin"
                            app:backgroundTint="@null"
                            android:background="@drawable/base_skill_icon"
                            android:text="+"/>
                        <Button
                            android:id="@+id/S_minus"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_margin="@dimen/stat_margin"
                            app:backgroundTint="@null"
                            android:background="@drawable/base_skill_icon"
                            android:text="-"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cost:"/>
                        <TextView
                            android:id="@+id/S_cost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lucida_calligraphy_italic"
                            android:textStyle="bold"
                            android:textSize="20dp"
                            android:text="2"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/stat_margin"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lucida_calligraphy_italic"
                        android:textStyle="bold"
                        android:textSize="24dp"
                        android:text="D:"/>
                    <TextView
                        android:id="@+id/D_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:fontFamily="@font/lucida_calligraphy_italic"
                        android:textStyle="bold"
                        android:textSize="24dp"
                        android:text="10"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/D_plus"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_margin="@dimen/stat_margin"
                            app:backgroundTint="@null"
                            android:background="@drawable/base_skill_icon"
                            android:text="+"/>
                        <Button
                            android:id="@+id/D_minus"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_margin="@dimen/stat_margin"
                            app:backgroundTint="@null"
                            android:background="@drawable/base_skill_icon"
                            android:text="-"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cost:"/>
                        <TextView
                            android:id="@+id/D_cost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lucida_calligraphy_italic"
                            android:textStyle="bold"
                            android:textSize="20dp"
                            android:text="2"/>
                    </LinearLayout>

                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/stat_margin"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lucida_calligraphy_italic"
                        android:textStyle="bold"
                        android:textSize="24dp"
                        android:text="V:"/>
                    <TextView
                        android:id="@+id/V_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:fontFamily="@font/lucida_calligraphy_italic"
                        android:textStyle="bold"
                        android:textSize="24dp"
                        android:text="10"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/V_plus"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_margin="@dimen/stat_margin"
                            app:backgroundTint="@null"
                            android:background="@drawable/base_skill_icon"
                            android:text="+"/>
                        <Button
                            android:id="@+id/V_minus"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_margin="@dimen/stat_margin"
                            app:backgroundTint="@null"
                            android:background="@drawable/base_skill_icon"
                            android:text="-"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cost:"/>
                        <TextView
                            android:id="@+id/V_cost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lucida_calligraphy_italic"
                            android:textStyle="bold"
                            android:textSize="20dp"
                            android:text="2"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/character_class_margin"
                android:gravity="end"
                android:orientation="vertical"
                android:layout_weight="1">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/stat_margin"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lucida_calligraphy_italic"
                        android:textStyle="bold"
                        android:textSize="24dp"
                        android:text="I:"/>
                    <TextView
                        android:id="@+id/I_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:fontFamily="@font/lucida_calligraphy_italic"
                        android:textStyle="bold"
                        android:textSize="24dp"
                        android:text="10"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/I_plus"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_margin="@dimen/stat_margin"
                            app:backgroundTint="@null"
                            android:background="@drawable/base_skill_icon"
                            android:text="+"/>
                        <Button
                            android:id="@+id/I_minus"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_margin="@dimen/stat_margin"
                            app:backgroundTint="@null"
                            android:background="@drawable/base_skill_icon"
                            android:text="-"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cost:"/>
                        <TextView
                            android:id="@+id/I_cost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lucida_calligraphy_italic"
                            android:textStyle="bold"
                            android:textSize="20dp"
                            android:text="2"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/stat_margin"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lucida_calligraphy_italic"
                        android:textStyle="bold"
                        android:textSize="24dp"
                        android:text="W:"/>
                    <TextView
                        android:id="@+id/W_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:fontFamily="@font/lucida_calligraphy_italic"
                        android:textStyle="bold"
                        android:textSize="24dp"
                        android:text="10"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/W_plus"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_margin="@dimen/stat_margin"
                            app:backgroundTint="@null"
                            android:background="@drawable/base_skill_icon"
                            android:text="+"/>
                        <Button
                            android:id="@+id/W_minus"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_margin="@dimen/stat_margin"
                            app:backgroundTint="@null"
                            android:background="@drawable/base_skill_icon"
                            android:text="-"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cost:"/>
                        <TextView
                            android:id="@+id/W_cost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lucida_calligraphy_italic"
                            android:textStyle="bold"
                            android:textSize="20dp"
                            android:text="2"/>
                    </LinearLayout>

                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/stat_margin"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lucida_calligraphy_italic"
                        android:textStyle="bold"
                        android:textSize="24dp"
                        android:text="C:"/>
                    <TextView
                        android:id="@+id/C_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:fontFamily="@font/lucida_calligraphy_italic"
                        android:textStyle="bold"
                        android:textSize="24dp"
                        android:text="10"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/C_plus"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_margin="@dimen/stat_margin"
                            app:backgroundTint="@null"
                            android:background="@drawable/base_skill_icon"
                            android:text="+"/>
                        <Button
                            android:id="@+id/C_minus"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_margin="@dimen/stat_margin"
                            app:backgroundTint="@null"
                            android:background="@drawable/base_skill_icon"
                            android:text="-"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cost:"/>
                        <TextView
                            android:id="@+id/C_cost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lucida_calligraphy_italic"
                            android:textStyle="bold"
                            android:textSize="20dp"
                            android:text="2"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center">
            <Button
                android:id="@+id/reset_attributes_button"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_margin="@dimen/frame_margin"
                app:backgroundTint="@null"
                android:background="@drawable/base_skill_icon"
                android:fontFamily="@font/lucida_calligraphy_italic"
                android:textStyle="bold"
                android:textSize="14dp"
                android:text="Reset"/>
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>