<?xml version="1.0" encoding="utf-8"?>
    <layer-list xmlns:android="http://schemas.android.com/apk/res/android">
        <item android:id="@android:id/background">
            <shape>
                <corners android:radius="4dp"/>
                <solid android:color="#D3D3D3"/>
                <gradient
                    android:type="linear"
                    android:startColor="#7e837e"
                    android:centerColor="#adb4ae"
                    android:endColor="#7e837e"
                    android:angle="90"/>
                <stroke
                    android:width="2dp"
                    android:color="@color/darkish"/>
            </shape>
        </item>

        <item android:id="@android:id/progress">
            <clip>
                <shape>
                    <corners android:radius="4dp"/>
                    <solid android:color="#FFD700"/> <!-- gold-like color -->
                    <gradient
                        android:type="linear"
                        android:startColor="#426723"
                        android:centerColor="#8bcb57"
                        android:endColor="#426723"
                        android:angle="90"/>
                    <stroke
                        android:width="2dp"
                        android:color="@color/darkish"/>
                </shape>
            </clip>
        </item>
    </layer-list>